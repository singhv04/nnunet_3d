# ===== OS / editor noise =====
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/
.idea/

# ===== Python =====
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
*.log

# ===== nnU-Net data directories =====
# Raw, preprocessed, and results/output data produced or consumed by nnU-Net
# should never be committed - it is large, regenerable, and often
# patient/subject data that shouldn't live in git history.
nnUNetFrame/dataset/nnUNet_raw/
nnUNetFrame/dataset/nnUNet_preprocessed/
nnUNetFrame/dataset/nnUNet_predictions/
nnUNetFrame/dataset/label_192/

# nnU-Net results directory: keep only what's needed to run inference
# (dataset.json, plans.json, and one checkpoint per fold, tracked via Git LFS
# below). Everything else - predictions, logs, plots, debug info - is ignored.
nnUNetFrame/dataset/nnUNet_results/**/validation/
nnUNetFrame/dataset/nnUNet_results/**/progress.png
nnUNetFrame/dataset/nnUNet_results/**/debug.json
nnUNetFrame/dataset/nnUNet_results/**/training_log_*.txt
nnUNetFrame/dataset/nnUNet_results.zip

# ===== Model weight / checkpoint files =====
# Ignored by default (large, regenerable via training). Files needed to run
# inference are tracked via Git LFS (see .gitattributes) and explicitly
# un-ignored below.
*.pth
*.pt
*.ckpt
*.h5
*.hdf5
*.onnx
*.pb
*.safetensors
*.weights

# Inference checkpoint(s) kept in the repo via Git LFS - one per trained fold.
!nnUNetFrame/dataset/nnUNet_results/Dataset101_BHSD/nnUNetTrainer__nnUNetResEncUNetMPlans__3d_fullres/fold_0/checkpoint_best.pth

# ===== Medical imaging / dataset file formats (anywhere in the repo) =====
*.nii
*.nii.gz
*.nrrd
*.mha
*.mhd
*.dcm
*.npy
*.npz

# ===== Archives (often bundled datasets/results) =====
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
